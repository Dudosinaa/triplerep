%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4d3c3dbd5617bdd458a97e4dbe1c95c2, type: 3}
  m_Name: ThirdMindDialogue
  m_EditorClassIdentifier: Assembly-CSharp::ThirdMindDialogueData
  opening:
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u042F \u0443\u0436\u0435 \u0432\u0441\u0451 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B.
      \u0412 \u0442\u043E\u0442 \u0432\u0435\u0447\u0435\u0440 \u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B
      \u0441\u043C\u0435\u043D\u0443 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439. \u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0437\u0430\u0447\u0435\u043C \u0432\u044B \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0435
      \u043C\u0435\u043D\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C
      \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435."
    voiceClip: {fileID: 8300000, guid: 2f9fc40d2a8e73c48be358bef90a7edf, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E
      \u043E \u0442\u043E\u0439 \u043D\u043E\u0447\u0438, \u0442\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C
      \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F.
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0432\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C."
    voiceClip: {fileID: 8300000, guid: 021c836233d0c0d49a3d5950ca3054ab, type: 3}
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u043E\u0433\u0434\u0430 \u044F \u0443\u0448\u0451\u043B. \u0427\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0433\u043E?"
    voiceClip: {fileID: 8300000, guid: 1fe109b55dbc28e43a1ca96d914a27a6, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0422\u044B \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E
      \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u043D\u0435
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F \u0432 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C?"
    voiceClip: {fileID: 8300000, guid: 1b2a6d9dfe4610a4f9fcaae3507743df, type: 3}
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E."
    voiceClip: {fileID: 8300000, guid: 7902e3c9e49ade04193a3dd9f648a74a, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0422\u043E\u0433\u0434\u0430 \u0443 \u043D\u0430\u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0435."
    voiceClip: {fileID: 8300000, guid: a3a3713a93332284caf8ed8c28728a34, type: 3}
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u041A\u0430\u043A\u0438\u0435 \u0435\u0449\u0451 \u0437\u0430\u043F\u0438\u0441\u0438?"
    voiceClip: {fileID: 8300000, guid: 7739a5dcebc93064399fa1d3de5812f6, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0414\u0430\u0432\u0430\u0439 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C
      \u0433\u0430\u0434\u0430\u0442\u044C. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u0441\u0430\u043C."
    voiceClip: {fileID: 8300000, guid: d367438c0996c6f47b16253bd6d9c4e3, type: 3}
  confession:
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0422\u044B \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B, \u0447\u0442\u043E
      \u0443\u0448\u0451\u043B \u0432 22:30. \u041D\u043E \u0432 23:44 \u0441\u0430\u043C
      \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B \u043A\u0430\u043C\u0435\u0440\u0443
      C-14. \u0417\u0430\u0447\u0435\u043C?"
    voiceClip: {fileID: 8300000, guid: f4cafb9454951b54c967b8caf09c3e44, type: 3}
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0418\u0432\u0430\u043D
      \u043C\u0435\u043D\u044F \u043F\u043E\u0434\u043A\u0443\u043F\u0438\u043B.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B, \u0447\u0442\u043E\u0431\u044B
      \u044F \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B \u043A\u0430\u043C\u0435\u0440\u0443.
      \u041C\u043D\u0435 \u0442\u043E\u0433\u0434\u0430 \u043E\u0447\u0435\u043D\u044C
      \u043D\u0443\u0436\u043D\u044B \u0431\u044B\u043B\u0438 \u0434\u0435\u043D\u044C\u0433\u0438\u2026
      \u0410 \u043E\u043D \u0443\u0432\u0435\u0440\u044F\u043B, \u0447\u0442\u043E
      \u044D\u0442\u043E \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0440\u0430\u0431\u043E\u0442\u044B"
    voiceClip: {fileID: 8300000, guid: 863dd489155c18a4f87a589c738e4ccf, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0422\u044B \u0437\u043D\u0430\u043B, \u0437\u0430\u0447\u0435\u043C
      \u043E\u043D \u043F\u043E\u0448\u0451\u043B \u0432 S-04? \u041C\u043E\u0435\u0433\u043E
      \u043E\u0442\u0446\u0430 \u0432\u0438\u0434\u0435\u043B?"
    voiceClip: {fileID: 8300000, guid: ec2d4cbd73c462347a0ec6a2208e16cd, type: 3}
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u041D\u0435\u0442! \u042F \u0442\u0443\u0434\u0430 \u0434\u0430\u0436\u0435
      \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u043B. \u041D\u0435 \u0432\u0438\u0434\u0435\u043B
      \u0442\u0432\u043E\u0435\u0433\u043E \u043E\u0442\u0446\u0430 \u0438 \u043F\u043E\u043D\u044F\u0442\u0438\u044F
      \u043D\u0435 \u0438\u043C\u0435\u043B, \u0447\u0442\u043E \u0418\u0432\u0430\u043D
      \u0434\u0435\u043B\u0430\u043B \u0432\u043D\u0443\u0442\u0440\u0438"
    voiceClip: {fileID: 8300000, guid: ff057e87a4d54a54abd4e7ed1477ed15, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B
      \u0441\u043E\u0432\u0440\u0430\u043B, \u0447\u0442\u043E \u0443\u0448\u0451\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435?"
    voiceClip: {fileID: 8300000, guid: 016e979864459614c8697044d49afeba, type: 3}
  - characterName: "\u041C\u0430\u0439\u043A\u043B"
    text: "\u0418\u0441\u043F\u0443\u0433\u0430\u043B\u0441\u044F. \u041A\u043E\u0433\u0434\u0430
      \u043C\u0435\u043D\u044F \u0432\u044B\u0437\u0432\u0430\u043B\u0438 \u0432
      \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435, \u044F \u0440\u0435\u0448\u0438\u043B,
      \u0447\u0442\u043E \u0432\u043E \u0432\u0441\u0451\u043C \u043E\u0431\u0432\u0438\u043D\u044F\u0442
      \u043C\u0435\u043D\u044F"
    voiceClip: {fileID: 8300000, guid: 638eb82f73b32e8439f9e41ae564661b, type: 3}
  - characterName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0418\u0432\u0430\u043D \u0437\u0430\u0440\u0430\u043D\u0435\u0435
      \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u043B\u0441\u044F, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0430\u043C\u0435\u0440\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0430\u2026"
    voiceClip: {fileID: 8300000, guid: b4ea923eda62c9849b468af7a86177ed, type: 3}
