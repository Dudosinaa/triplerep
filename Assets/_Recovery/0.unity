  objective: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0441\u0442\u043E\u043B
    \u0418\u0432\u0430\u043D\u0430"
  prompt: "E \u2014 \u0418\u0437\u0443\u0447\u0438\u0442\u044C \u0441\u0442\u043E\u043B
    \u0418\u0432\u0430\u043D\u0430"
  hint: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0441\u0442\u043E\u043B \u0418\u0432\u0430\u043D\u0430
