--- !u!114 &1197382734
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1197382733}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22fef5450aea9c147a05419dd5139241, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FatherCutsceneController
  player: {fileID: 1395016068}
  view: {fileID: 185203938}
  interactions: {fileID: 1101739921}
  hud: {fileID: 1878487328}
  subtitles: {fileID: 105020111}
  clickHint: {fileID: 281471152}
  father: {fileID: 1050285015}
  head: {fileID: 1050285014}
  chest: {fileID: 1050285013}
  hips: {fileID: 1050285011}
  hallEye: {fileID: 1674155626}
  roomEye: {fileID: 383881159}
  conversationEye: {fileID: 636408771}
  blackout: {fileID: 917008054}
  lines:
  - speaker: "\u041E\u0422\u0415\u0426"
    text: "\u0427\u0442\u043E?.. \u0413\u0434\u0435 \u044F?.. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0448\u043B\u043E?.."
  - speaker: "\u041E\u0422\u0415\u0426"
    text: "\u0410\u043B\u0451\u0448\u0430?.. \u042D\u0442\u043E \u0442\u044B?.. \u0410\u043B\u0451\u0448\u0430,
      \u043D\u0435\u0443\u0436\u0435\u043B\u0438 \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430
      \u0442\u044B?.."
  - speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041F\u0430\u043F\u0430?.. \u042D\u0442\u043E \u044F. \u042F \u0437\u0434\u0435\u0441\u044C.
      \u041C\u044B \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442
      \u0442\u0435\u0431\u044F \u0438\u0441\u043A\u0430\u043B\u0438... \u042F \u0434\u0443\u043C\u0430\u043B,
      \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u0442\u0435\u0431\u044F \u043D\u0435 \u0443\u0432\u0438\u0436\u0443"
  - speaker: "\u041E\u0422\u0415\u0426"
    text: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u043A\u0430\u043A \u0442\u044B
      \u0437\u0432\u0430\u043B \u043C\u0435\u043D\u044F... \u0434\u0430\u0436\u0435
      \u0442\u0430\u043C. \u041D\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437
      \u0431\u043E\u044F\u043B\u0441\u044F, \u0447\u0442\u043E \u044D\u0442\u043E
      \u043E\u043F\u044F\u0442\u044C \u043D\u0435 \u0442\u044B"
  - speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u0412\u0441\u0451 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C.
      \u041C\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u043C\u0441\u044F \u043E\u0442\u0441\u044E\u0434\u0430,
      \u0441\u043B\u044B\u0448\u0438\u0448\u044C? \u042F \u043F\u043E\u043C\u043E\u0433\u0443
      \u0442\u0435\u0431\u0435. \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u0451
      \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E"
  - speaker: "\u041E\u0422\u0415\u0426"
    text: "\u041D\u0435\u0442, \u0441\u044B\u043D\u043E\u043A... \u041E\u043D\u0438
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u043E\u0451 \u0442\u0435\u043B\u043E. \u0410 \u0447\u0442\u043E-\u0442\u043E
      \u0432\u043D\u0443\u0442\u0440\u0438 \u043C\u0435\u043D\u044F \u0442\u0430\u043A
      \u0438 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E \u0442\u0443
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u0442\u0430\u043A.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430... \u041F\u0440\u043E\u0441\u0442\u043E
      \u0434\u0430\u0439 \u043C\u043D\u0435 \u0440\u0443\u043A\u0443. \u041C\u044B
      \u0432\u0435\u0434\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0448\u043B\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430"
  - speaker: "\u041E\u0422\u0415\u0426"
    text: "\u041F\u0440\u043E\u0441\u0442\u0438 \u043C\u0435\u043D\u044F, \u0410\u043B\u0451\u0448\u0430...
      \u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u0442\u0435\u0431\u0435 \u043D\u0430\u043C\u043D\u043E\u0433\u043E
      \u0440\u0430\u043D\u044C\u0448\u0435. \u042F \u0442\u0430\u043A \u0442\u0435\u0431\u044F
      \u043B\u044E\u0431\u043B\u044E, \u0441\u044B\u043D\u043E\u043A..."
  - speaker: "\u0410\u041B\u0415\u041A\u0421\u0415\u0419"
    text: "\u041F\u0430\u043F\u0430?.. \u041F\u0430\u043F\u0430, \u043D\u0435\u0442!
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u043C\u0435\u043D\u044F!.."
  - speaker: "\u0418\u0412\u0410\u041D"
    text: "\u041D\u0435\u0442, \u043F\u0430\u043F\u0430... \u0410\u043B\u0435\u043A\u0441\u0435\u0439,
      \u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u043E\u043D \u0434\u044B\u0448\u0438\u0442!"
