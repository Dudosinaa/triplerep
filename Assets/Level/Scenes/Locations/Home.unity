--- !u!114 &1793207051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1793207050}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3fa4a8d294190e478217235f3ef757a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhoneCall
  taskList: {fileID: 1719091403}
  ringDelay: 15
  dialogue:
  - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u2014 \u0410\u043B\u043B\u043E?.. \u0418\u0432\u0430\u043D? \u0422\u044B
      \u0432\u0440\u0435\u043C\u044F \u0432\u0438\u0434\u0435\u043B?"
  - speaker: "\u0418\u0432\u0430\u043D"
    text: "\u2014 \u041B\u0451\u0448\u0430, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u043A\u043B\u0430\u0434\u0438 \u0442\u0440\u0443\u0431\u043A\u0443.
      \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043D\u0430\u0448\u0451\u043B
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u0438\u0434\u0435\u043B \u043E\u0442\u0446\u0430 \u043F\u043E\u0441\u043B\u0435
      \u0435\u0433\u043E \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u044F."
  - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u2014 \u041E\u043F\u044F\u0442\u044C? \u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0440\u0430\u0437 \u0442\u0432\u043E\u0439 \xAB\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\xBB
      \u0434\u0430\u0436\u0435 \u0444\u0430\u043C\u0438\u043B\u0438\u044E \u043D\u0430\u0448\u0443
      \u043D\u0435 \u0437\u043D\u0430\u043B."
  - speaker: "\u0418\u0432\u0430\u043D"
    text: "\u2014 \u042D\u0442\u043E\u0442 \u0437\u043D\u0430\u043B. \u0418 \u0435\u0449\u0451
      \u043A\u043E\u0435-\u0447\u0442\u043E... \u041F\u043E\u043C\u043D\u0438\u0448\u044C
      \u0434\u0432\u0435\u0440\u044C \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435
      \u043D\u0430\u0448\u0435\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430? \u041E\u043D \u0441\u0430\u043C \u043E \u043D\u0435\u0439
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B."
  - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u2014 \u041E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435
      \u0437\u043D\u0430\u0435\u0442 \u043F\u0440\u043E \u043F\u043E\u0434\u0432\u0430\u043B?
      \u0413\u0434\u0435 \u0442\u044B \u0435\u0433\u043E \u043D\u0430\u0448\u0451\u043B?"
  - speaker: "\u0418\u0432\u0430\u043D"
    text: "\u2014 \u0412 \u043C\u0435\u0442\u0440\u043E. \u041E\u043D \u0441\u0435\u0439\u0447\u0430\u0441
      \u0432 \u043D\u043E\u0447\u043D\u043E\u043C \u043F\u043E\u0435\u0437\u0434\u0435.
      \u042F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0441 \u043D\u0438\u043C
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043D\u043E
      \u043E\u043D \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0441\u044F \u043C\u0435\u043D\u044F.
      \u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u0442\u043E\u0431\u043E\u0439."
  - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u2014 \u0421\u043E \u043C\u043D\u043E\u0439? \u0418\u0432\u0430\u043D,
      \u0442\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0431\u0440\u0435\u0434\u043E\u0432\u043E \u044D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442?"
  - speaker: "\u0418\u0432\u0430\u043D"
    text: "\u2014 \u041F\u043E\u043D\u0438\u043C\u0430\u044E. \u041D\u043E \u043E\u043D
      \u0437\u043D\u0430\u0435\u0442 \u0442\u043E, \u0447\u0435\u0433\u043E \u0437\u043D\u0430\u0442\u044C
      \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D. \u0418 \u043F\u043E\u0435\u0437\u0434
      \u0441\u043A\u043E\u0440\u043E \u0443\u0439\u0434\u0451\u0442 \u0432 \u0434\u0435\u043F\u043E.
      \u0414\u0440\u0443\u0433\u043E\u0433\u043E \u0448\u0430\u043D\u0441\u0430 \u043C\u043E\u0436\u0435\u0442
      \u043D\u0435 \u0431\u044B\u0442\u044C."
  - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u2014 \u0427\u0451\u0440\u0442... \u041B\u0430\u0434\u043D\u043E. \u041A\u0443\u0434\u0430
      \u0435\u0445\u0430\u0442\u044C?"
  - speaker: "\u0418\u0432\u0430\u043D"
    text: "\u2014 \u041B\u0438\u043D\u0438\u044F A, \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0411\u0440\u0443\u043A\u043B\u0438\u043D\u0430. \u0421\u0430\u0434\u0438\u0441\u044C
      \u043D\u0430 14-\u0439 \u0443\u043B\u0438\u0446\u0435, \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0432\u0430\u0433\u043E\u043D. \u042F \u0431\u0443\u0434\u0443 \u0442\u0430\u043C."
  - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
    text: "\u2014 \u0418 \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u043E\u043F\u044F\u0442\u044C
      \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0442\u0432\u043E\u044F \u0438\u0433\u0440\u0430..."
  - speaker: "\u0418\u0432\u0430\u043D"
    text: "\u2014 \u0422\u043E\u0433\u0434\u0430 \u0441 \u043C\u0435\u043D\u044F
      \u0432\u044B\u043F\u0438\u0432\u043A\u0430. \u041A\u0430\u043A \u0432 \u0441\u0442\u0430\u0440\u044B\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0430. \u0414\u0430\u0432\u0430\u0439,
      \u0431\u0440\u0430\u0442. \u042F \u0436\u0434\u0443."
