--- !u!114 &721644834
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 721644833}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd4ba57952f78394aa05eeeba1f6b390, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableDocument
  documentTitle: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440"
  documentText: "\u041C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u043A\u0430 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430:
    \u041A-17. \u0414\u0430\u0442\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438:
    14.06.2004. \u041F\u043E\u0434\u043F\u0438\u0441\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F:
    \u0418. \u041A\u0430\u0440\u0430\u043C\u0430\u0437\u043E\u0432. \u0410\u0434\u0440\u0435\u0441
    \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044F: \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0441\u043A\u043B\u0430\u0434, \u041D\u044C\u044E-\u0419\u043E\u0440\u043A.
    \u041D\u043E\u043C\u0435\u0440 \u041A-17 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442
    \u0441 \u043C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u043A\u0430\u0441\u0441\u0435\u0442\u044B
    \u0438\u0437 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F."
