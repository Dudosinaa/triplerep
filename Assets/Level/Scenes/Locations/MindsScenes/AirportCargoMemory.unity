  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableDocument
  documentTitle: "\u0421\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u0431\u0430\u0433\u0430\u0436"
  documentText: "\u041D\u0430\u043A\u043B\u0430\u0434\u043D\u0430\u044F F-04. \u041E\u0442\u043F\u0440\u0430\u0432\u043A\u0430:
    12.06.2004. \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C:
    \u0421\u0435\u0440\u0433\u0435\u0439 \u041A\u0430\u0440\u0430\u043C\u0430\u0437\u043E\u0432.
    \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C: \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439
    \u0431\u0430\u0433\u0430\u0436, \u041D\u044C\u044E-\u0419\u043E\u0440\u043A.
    \u0412 \u0441\u043F\u0438\u0441\u043A\u0435 \u043D\u0435\u0442 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F."
