--- !u!114 &1474155509
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1474155507}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a59ebb1e58ca02d4fa2bc995dce71230, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  characterName: "\u0422\u0438\u0445\u043E\u043D \u0418\u043D\u043E\u043A\u0435\u043D\u0442\u044C\u0435\u0432\u0438\u0447"
  playerName: "\u0412\u044B"
  openingLine: 
  startNodeId: 0
  nodes:
  - id: 0
    npcText: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439, \u043F\u043E\u043C\u043E\u0433\u0438
      \u043D\u0430\u0439\u0442\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u0443\u044E
      \u043D\u0430 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440. \u0422\u0440\u0438
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u044B
      \u0432 \u0430\u043D\u0433\u0430\u0440\u0435. \u0421\u0432\u0435\u0440\u044C
      \u043D\u043E\u043C\u0435\u0440, \u0434\u0430\u0442\u0443, \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F
      \u0438 \u0430\u0434\u0440\u0435\u0441 \u043D\u0430 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0435."
    choices:
    - text: "\u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B."
      nextNode: 1
      targetNodeId: 0
      action: 0
    - text: "\u0427\u0442\u043E \u0442\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C
        \u043E \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0435?"
      nextNode: 1
      targetNodeId: 0
      action: 0
    - text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u043C\u043E\u0442\u0440\u044E\u0441\u044C."
      nextNode: -1
      targetNodeId: 0
      action: 0
  - id: 0
    npcText: "\u041F\u043E\u043C\u043D\u044E \u043C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u043A\u0443
      \u041A-17 \u2014 \u043A\u0430\u043A \u043D\u0430 \u0442\u043E\u0439 \u043A\u0430\u0441\u0441\u0435\u0442\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0451\u0448\u044C \u0437\u0430\u043F\u0438\u0441\u044C,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044C
      \u0438 \u0441\u043A\u043B\u0430\u0434 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    choices:
    - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043F\u0440\u043E\u0432\u0435\u0440\u044E."
      nextNode: -1
      targetNodeId: 0
      action: 0
    - text: "\u041F\u043E\u0432\u0442\u043E\u0440\u0438 \u043F\u0440\u043E \u043A\u0430\u0441\u0441\u0435\u0442\u0443."
      nextNode: 1
