--- !u!114 &1562637555
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1562637554}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2bf19d46ff1c720418528aa7bd06aec7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThirdMindDocumentSurface
  documentId: 1
  documentTitle: "\u0421\u041B\u0423\u0416\u0415\u0411\u041D\u0410\u042F \u0417\u0410\u042F\u0412\u041A\u0410"
  fullText: "\u041D\u0430 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0432\u0438\u0434\u0435\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F\n\n\u041E\u0431\u044A\u0435\u043A\u0442:
    \u041A\u0430\u043C\u0435\u0440\u0430 \u0432\u0438\u0434\u0435\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F
    C-14\n\u0414\u0430\u0442\u0430: 14 \u043E\u043A\u0442\u044F\u0431\u0440\u044F
    1999 \u0433\u043E\u0434\u0430\n\u0412\u0440\u0435\u043C\u044F \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F:
    23:44\n\u0418\u043D\u0438\u0446\u0438\u0430\u0442\u043E\u0440 \u0437\u0430\u044F\u0432\u043A\u0438:
    \u041C\u0430\u0439\u043A\u043B \u0420\u0438\u0434\n\u041C\u0435\u0441\u0442\u043E
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438: \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u0435\u043A\u0442\u043E\u0440\n\n\u041F\u0440\u043E\u0448\u0443
    \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u043A\u0430\u043C\u0435\u0440\u0443
    \u0432\u0438\u0434\u0435\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F
    C-14 \u0432 \u0440\u0435\u0436\u0438\u043C \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0434\u043B\u044F
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0438
    \u043B\u0438\u043D\u0438\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438
    \u0441\u0438\u0433\u043D\u0430\u043B\u0430.\n\n\u041D\u0430 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442
    \u0437\u0430\u043F\u0438\u0441\u044C \u0441 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439
    \u043A\u0430\u043C\u0435\u0440\u044B \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
    \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430.\n\n\u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0430\u0431\u043E\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0448\u0442\u0430\u0442\u043D\u044B\u0439
    \u0440\u0435\u0436\u0438\u043C \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F.\n\n\u0417\u0430\u044F\u0432\u043A\u0430
    \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0430 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u0430:
    \u041C\u0430\u0439\u043A\u043B \u0420\u0438\u0434\n\u0412\u0440\u0435\u043C\u044F
    \u043F\u043E\u0434\u043F\u0438\u0441\u0438: 23:44"
  firstEventTime: 23:44
