--- !u!114 &1495064015
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1495064014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2bf19d46ff1c720418528aa7bd06aec7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThirdMindDocumentSurface
  documentId: 0
  documentTitle: "\u041F\u0418\u0421\u042C\u041C\u0415\u041D\u041D\u041E\u0415 \u041E\u0411\u042A\u042F\u0421\u041D\u0415\u041D\u0418\u0415"
  fullText: "\u0414\u0430\u0442\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F:
    15.10.1999\n\n\u041E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
    \u0440\u0430\u0431\u043E\u0447\u0435\u0439 \u0441\u043C\u0435\u043D\u044B\n\n\u042F,
    \u041C\u0430\u0439\u043A\u043B \u0420\u0438\u0434, \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430,
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E,
    \u0447\u0442\u043E 14 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1999 \u0433\u043E\u0434\u0430
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0447\u0443\u044E
    \u0441\u043C\u0435\u043D\u0443 \u0438 \u043F\u043E\u043A\u0438\u043D\u0443\u043B
    \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u0432 22:30.\n\n\u041F\u043E\u0441\u043B\u0435
    \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
