  m_Script: {fileID: 11500000, guid: 2bf19d46ff1c720418528aa7bd06aec7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThirdMindDocumentSurface
  documentId: 2
  documentTitle: "\u0416\u0423\u0420\u041D\u0410\u041B \u0423\u0427\u0401\u0422\u0410
    \u0414\u041E\u0421\u0422\u0423\u041F\u0410"
  fullText: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435
    S-04\n\n<nobr>\u0414\u0430\u0442\u0430<pos=34%>\u0412\u0440\u0435\u043C\u044F<pos=54%>\u0421\u043E\u0431\u044B\u0442\u0438\u0435<pos=80%>\u041B\u0438\u0446\u043E</nobr>\n<nobr>14.10.1999<pos=34%>23:51<pos=54%>\u0412\u0445\u043E\u0434<pos=80%>\u0418\u0432\u0430\u043D</nobr>\n<nobr>15.10.1999<pos=34%>00:16<pos=54%>\u0412\u044B\u0445\u043E\u0434<pos=80%>\u0418\u0432\u0430\u043D</nobr>\n\n\u0421\u0438\u0441\u0442\u0435\u043C\u0430
    \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0438
    \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0432 \u0441\u0435\u043A\u0442\u043E\u0440
    S-04. \u0412\u0440\u0435\u043C\u044F \u0437\u0430\u043F\u0438\u0441\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043C\u043E\u043C\u0435\u043D\u0442\u0443 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043D\u0438\u044F
    \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\n\n\u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A:
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
    \u0434\u043E\u0441\u0442\u0443\u043F\u0430\n\u0421\u0442\u0430\u0442\u0443\u0441
    \u0437\u0430\u043F\u0438\u0441\u0438: \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0430"
