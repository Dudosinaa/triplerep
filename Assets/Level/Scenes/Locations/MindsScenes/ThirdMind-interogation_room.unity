    \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0435\u0439 \u043D\u0435
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F. \u041E \u043A\u0430\u043A\u0438\u0445-\u043B\u0438\u0431\u043E
    \u0432\u043D\u0435\u043F\u043B\u0430\u043D\u043E\u0432\u044B\u0445 \u0440\u0430\u0431\u043E\u0442\u0430\u0445
    \u0432 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0441\u0435\u043A\u0442\u043E\u0440\u0435
    \u0432 \u043D\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u043D\u0435
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.\n\n\u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E.
    \u0421\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0433\u043E
