  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2bf19d46ff1c720418528aa7bd06aec7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ThirdMindDocumentSurface
  documentId: 3
  documentTitle: "\u041E\u0422\u0427\u0401\u0422 \u041F\u041E \u041C\u0410\u0422\u0415\u0420\u0418\u0410\u041B\u0410\u041C
    \u0412\u0418\u0414\u0415\u041E\u041D\u0410\u0411\u041B\u042E\u0414\u0415\u041D\u0418\u042F"
  fullText: "\u041A\u0430\u043C\u0435\u0440\u0430 C-12 \u2014 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
    \u0432\u043E\u0437\u043B\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    S-04\n\u0414\u0430\u0442\u0430: \u043D\u043E\u0447\u044C \u0441 14 \u043D\u0430
    15 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1999 \u0433\u043E\u0434\u0430\n\n\u041F\u0440\u0438
    \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435 \u0430\u0440\u0445\u0438\u0432\u043D\u043E\u0439
    \u0437\u0430\u043F\u0438\u0441\u0438 \u043A\u0430\u043C\u0435\u0440\u044B C-12
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0434\u0432\u0430
    \u043C\u043E\u043C\u0435\u043D\u0442\u0430, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0435
