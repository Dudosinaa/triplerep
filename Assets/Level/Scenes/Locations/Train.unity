--- !u!114 &555131206
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 555131201}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a59ebb1e58ca02d4fa2bc995dce71230, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  characterName: "\u041F\u0435\u0442\u0440\u043E\u0432\u0438\u0447"
  playerName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  openingLine: "\u041F\u0435\u0442\u0440\u043E\u0432\u0438\u0447?.. \u042D\u0442\u043E
    \u0432\u044B? \u0427\u0442\u043E \u0432\u044B \u0437\u0434\u0435\u0441\u044C
    \u0434\u0435\u043B\u0430\u0435\u0442\u0435?"
  startNodeId: 1
  nodes:
  - id: 1
    npcText: "\u041B\u0451\u0448\u043A\u0430? \u0412\u043E\u0442 \u0442\u0430\u043A
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430... \u0412\u044B\u0440\u043E\u0441-\u0442\u043E
      \u043A\u0430\u043A. \u0410 \u044F \u0442\u0435\u0431\u044F \u0432\u0441\u0451
      \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u043E\u0439 \u043F\u043E\u043C\u043D\u044E."
    choices:
    - text: "\u0412\u044B \u0432\u0435\u0434\u044C \u0435\u0449\u0451 \u0432 \u0421\u043E\u044E\u0437\u0435
        \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C. \u041A\u0430\u043A \u0432\u044B
        \u0432\u043E\u043E\u0431\u0449\u0435 \u0441\u044E\u0434\u0430 \u043F\u043E\u043F\u0430\u043B\u0438?"
      nextNode: -1
      targetNodeId: 2
      action: 0
  - id: 2
    npcText: "\u0414\u043E\u043B\u0433\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F,
      \u0441\u044B\u043D\u043E\u043A. \u041B\u0443\u0447\u0448\u0435 \u0441\u043A\u0430\u0436\u0438,
      \u043E\u0442\u0446\u0430 \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0430\u0432\u043D\u043E
      \u0432\u0438\u0434\u0435\u043B?"
    choices:
    - text: "\u0414\u0430\u0432\u043D\u043E. \u0410 \u0432\u044B \u0447\u0442\u043E-\u0442\u043E
        \u0437\u043D\u0430\u0435\u0442\u0435?"
      nextNode: -1
      targetNodeId: 3
      action: 0
  - id: 3
    npcText: "\u041F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A \u043E\u043D \u0441
      \u0418\u0432\u0430\u043D\u043E\u043C \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435
      \u0432\u043E\u0437\u0438\u043B\u0438\u0441\u044C. \u041D\u043E\u0447\u0430\u043C\u0438
      \u043D\u0435 \u0441\u043F\u0430\u043B\u0438. \u0410 \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u043C\u0435\u043D\u044F \u043A\u043E\u0435-\u0447\u0442\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C."
    choices:
    - text: "\u0427\u0442\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C?"
      nextNode: -1
      targetNodeId: 4
      action: 0
  - id: 4
    npcText: "\u042D\u0445... \u041F\u0430\u043C\u044F\u0442\u044C \u0443\u0436\u0435
      \u043D\u0435 \u0442\u0430. \u041D\u043E \u0442\u043E\u0442 \u0432\u0435\u0447\u0435\u0440
      \u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0437\u0430\u0431\u044B\u0442\u044C
      \u043D\u0435 \u043C\u043E\u0433\u0443."
    choices:
    - text: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
      nextNode: -1
      targetNodeId: 0
      action: 1
