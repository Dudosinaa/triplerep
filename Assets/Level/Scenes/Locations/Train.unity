--- !u!114 &388684180
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 388684179}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a59ebb1e58ca02d4fa2bc995dce71230, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  characterName: "\u041C\u0430\u0439\u043A\u043B"
  playerName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  openingLine: "\u041C\u0430\u0439\u043A\u043B? \u0412\u043E\u0442 \u0443\u0436 \u043A\u043E\u0433\u043E
    \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B \u0437\u0434\u0435\u0441\u044C
    \u0443\u0432\u0438\u0434\u0435\u0442\u044C."
  startNodeId: 1
  nodes:
  - id: 1
    npcText: "\u041E\u0444\u0438\u0446\u0435\u0440 \u041A\u0430\u0440\u0430\u043C\u0430\u0437\u043E\u0432...
      \u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u044F \u0432\u0435\u0434\u044C
      \u0443\u0436\u0435 \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B."
    choices:
    - text: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0435\u043C\u0443
        \u0442\u044B \u0442\u0430\u043A \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u0435\u0448\u044C?"
      nextNode: -1
      targetNodeId: 2
      action: 0
  - id: 2
    npcText: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0440\u0430\u0437 \u043D\u0430\u0448 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E."
    choices:
    - text: "\u0422\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0441 \u043C\u043E\u0438\u043C
        \u0431\u0440\u0430\u0442\u043E\u043C. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
        \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D \u0434\u0435\u043B\u0430\u043B
        \u0432 \u0442\u0443 \u043D\u043E\u0447\u044C."
      nextNode: -1
      targetNodeId: 3
      action: 0
  - id: 3
    npcText: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043B
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435. \u041D\u0435
      \u043B\u0435\u0437 \u0442\u0443\u0434\u0430, \u043A\u0443\u0434\u0430 \u043D\u0435
      \u043F\u0440\u043E\u0441\u0438\u043B\u0438."
    choices:
    - text: "\u0422\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435\u0447\u0435\u0433\u043E
        \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C. \u0412\u0435\u0440\u043D\u043E?"
      nextNode: -1
      targetNodeId: 4
      action: 0
  - id: 4
    npcText: "...\u0412\u044B \u0432\u0435\u0434\u044C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043C\u043D\u0435 \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435."
    choices:
    - text: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
      nextNode: -1
      targetNodeId: 0
      action: 1
  scriptedLines: []
