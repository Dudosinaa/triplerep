--- !u!114 &839056223
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 839056221}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a59ebb1e58ca02d4fa2bc995dce71230, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  characterName: "\u0418\u0432\u0430\u043D"
  playerName: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  openingLine: 
  startNodeId: 0
  nodes: []
  scriptedLines:
  - playerSpeaks: 1
    text: "\u2014 \u0418\u0432\u0430\u043D! \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u041F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441."
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u041B\u0451\u0448\u0430, \u043D\u0435 \u0432\u0440\u0435\u043C\u044F.
      \u042F \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B."
    pauseBefore: 0
    cue: 
  - playerSpeaks: 1
    text: "\u2014 \u0417\u0430\u043A\u043E\u043D\u0447\u0438\u043B \u0447\u0442\u043E?!
      \u042F \u0432\u0438\u0434\u0435\u043B \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B,
      \u0418\u0432\u0430\u043D. \u0422\u044B \u0432\u043E\u0448\u0451\u043B \u0432
      \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u0432 23:51, \u0430 \u0447\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442 \u0432\u044B\u0448\u0435\u043B \u043E\u0434\u0438\u043D.
      \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0441
      \u043E\u0442\u0446\u043E\u043C?!"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u0422\u044B \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0442\u043E\u0439
      \u043D\u043E\u0447\u044C\u044E."
    pauseBefore: 0
    cue: 
  - playerSpeaks: 1
    text: "\u2014 \u0422\u0430\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u0438!
      \u042F \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u0435\u0433\u043E \u0438\u0441\u043A\u0430\u043B,
      \u0430 \u0442\u044B \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u0437\u043D\u0430\u043B \u043F\u0440\u0430\u0432\u0434\u0443!"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u042F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0432\u0441\u0451
      \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C! \u0422\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
      \u043C\u043D\u0435 \u0431\u044B\u043B\u043E \u043B\u0435\u0433\u043A\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u043A\u0430\u043A \u0442\u044B
      \u0435\u0433\u043E \u0438\u0449\u0435\u0448\u044C?!"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 1
    text: "\u2014 \u0422\u043E\u0433\u0434\u0430 \u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435
      \u043F\u0440\u044F\u043C\u043E. \u0422\u044B \u0435\u0433\u043E \u0443\u0431\u0438\u043B?"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u041D\u0435\u0442, \u041B\u0451\u0448\u0430. \u041E\u0442\u0435\u0446
      \u0436\u0438\u0432."
    pauseBefore: 0.75
    cue: LookAtPlayer
  - playerSpeaks: 1
    text: "\u2014 \u0427\u0442\u043E?.. \u0427\u0442\u043E \u0442\u044B \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441\u043A\u0430\u0437\u0430\u043B?"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u042F \u043D\u0430\u0448\u0451\u043B \u0441\u043F\u043E\u0441\u043E\u0431
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0433\u043E. \u041C\u044B
      \u0431\u043B\u0438\u0436\u0435, \u0447\u0435\u043C \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E.
      \u0418 \u0442\u044B \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D."
    pauseBefore: 0
    cue: 
  - playerSpeaks: 1
    text: "\u2014 \u0414\u043B\u044F \u0447\u0435\u0433\u043E? \u0427\u0442\u043E
      \u0437\u0430 \u041A-17? \u0418 \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0435
      \u044D\u0442\u0438 \u043B\u044E\u0434\u0438 \u0432 \u0432\u0430\u0433\u043E\u043D\u0435
      \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u0441 \u043D\u0430\u0448\u0438\u043C
      \u043F\u0440\u043E\u0448\u043B\u044B\u043C?!"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u0422\u044B \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0451, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u043D\u0443\u0436\u043D\u043E. \u041E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u044D\u0442\u0430\u043F."
    pauseBefore: 0
    cue: 
  - playerSpeaks: 1
    text: "\u2014 \u0422\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
      \u043C\u0435\u043D\u044F?! \u0418\u0432\u0430\u043D, \u0441\u0442\u043E\u0439!
      \u041C\u044B \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u043F\u043E\u0439\u0434\u0451\u043C,
      \u043F\u043E\u043A\u0430 \u0442\u044B \u0432\u0441\u0451 \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0448\u044C!"
    pauseBefore: 0
    cue: 
  - playerSpeaks: 0
    text: "\u2014 \u0415\u0441\u043B\u0438 \u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C, \u043C\u044B
      \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u043C \u043E\u0442\u0446\u0430 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
      \u041F\u0440\u043E\u0441\u0442\u0438, \u0431\u0440\u0430\u0442."
    pauseBefore: 0.45
    cue: BackAway
