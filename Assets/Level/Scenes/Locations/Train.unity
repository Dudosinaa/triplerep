  - id: 1
    npcText: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u042F \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u043D\u0430
      \u0433\u0440\u0443\u0437\u043E\u0432\u043E\u043C \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0435.
      \u0427\u0435\u0440\u0435\u0437 \u043C\u0435\u043D\u044F \u043C\u043D\u043E\u0433\u043E
      \u043B\u044E\u0434\u0435\u0439 \u043F\u0440\u043E\u0448\u043B\u043E."
    choices:
    - text: "\u041A\u0430\u0440\u0430\u043C\u0430\u0437\u043E\u0432. \u042D\u0442\u0430
        \u0444\u0430\u043C\u0438\u043B\u0438\u044F \u0432\u0430\u043C \u043E \u0447\u0451\u043C-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442?"
      nextNode: -1
      targetNodeId: 2
      action: 0
  - id: 2
    npcText: "\u041A\u0430\u0440\u0430\u043C\u0430\u0437\u043E\u0432... \u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435.
      \u0412\u044B \u0432\u0435\u0434\u044C \u0441 \u0441\u0435\u043C\u044C\u0451\u0439
      \u0438\u0437 \u0421\u043E\u044E\u0437\u0430 \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u043B\u0438?"
    choices:
    - text: "\u0412\u0435\u0440\u043D\u043E. \u0412\u044B \u0447\u0442\u043E-\u0442\u043E
        \u043F\u043E\u043C\u043D\u0438\u0442\u0435?"
      nextNode: -1
      targetNodeId: 3
      action: 0
  - id: 3
    npcText: "\u0412\u0430\u0448 \u0431\u0430\u0433\u0430\u0436 \u2014 \u0434\u0430.
      \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043E\u0434\u0438\u043D \u044F\u0449\u0438\u043A.
      \u0421 \u043D\u0438\u043C \u0442\u043E\u0433\u0434\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u043E\u0437\u043D\u0438 \u0431\u044B\u043B\u043E..."
    choices:
    - text: "\u0427\u0442\u043E \u0437\u0430 \u044F\u0449\u0438\u043A?"
      nextNode: -1
      targetNodeId: 4
      action: 0
  - id: 4
    npcText: "\u042F \u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0432\u0430\u043C
      \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u0443\u044E, \u043D\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u0442 \u043F\u0440\u043E\u0448\u043B\u043E... \u0425\u043E\u0442\u044F
      \u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u044F \u043F\u043E\u043C\u043D\u044E
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0445\u043E\u0440\u043E\u0448\u043E."
    choices:
    - text: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
      nextNode: -1
      targetNodeId: 0
      action: 1
