--- !u!114 &2136944608313171637
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2173870692353758123}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9429685eebee89c41a765a447491df8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalLab.Investigation.InvestigationDocument
  record:
    id: "\u041A1"
    title: "\u041A-17. \u0422\u0415\u0425\u041D\u0418\u0427\u0415\u0421\u041A\u0418\u0419
      \u041F\u0410\u0421\u041F\u041E\u0420\u0422"
    date: "1989 \u0433\u043E\u0434"
    body: "\u041A-17 \u2014 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u043E\u0439
      \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u043D\u044B\u0439 \u043C\u043E\u0434\u0443\u043B\u044C
      \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \xAB\u041D\u0435\u0447\u0438\u0441\u0442\u044C\xBB.\n\u0420\u0435\u0436\u0438\u043C
      \u0410 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u0433\u043D\u0430\u043B,
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442 \u043E\u0431\u043B\u0430\u0441\u0442\u044C
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430.\n\u0420\u0435\u0436\u0438\u043C
      \u0411 \u043C\u0435\u043D\u044F\u0435\u0442 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u0430 \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
      \u0434\u043B\u044F \u0432\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u044F
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u0441\u0438\u0433\u043D\u0430\u043B\u0430
      \u0432 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u0439 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A.\n\u041F\u043E\u043B\u043D\u0430\u044F
      \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F \u043D\u0438 \u0440\u0430\u0437\u0443
      \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u043C.\n\u0420\u0430\u0441\u0447\u0451\u0442\u044B
      \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435
      \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0433\u043E \u0446\u0438\u043A\u043B\u0430.\n\u041F\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u043C\u043E\u0434\u0443\u043B\u044F
      \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0440\u0443\u0448\u0438\u0442\u044C
      \u0433\u0440\u0430\u043D\u0438\u0446\u044B \u043A\u043E\u043D\u0442\u0443\u0440\u0430.\n\u0420\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0441 \u043D\u0438\u043C \u0431\u0435\u0437 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0433\u043E
      \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E."
    style: "\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F."
    stamp: 
    point: 3
  kind: 0
  presentation: 0
