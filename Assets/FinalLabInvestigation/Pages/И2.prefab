--- !u!114 &3316963078447961776
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2401411527495970469}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9429685eebee89c41a765a447491df8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalLab.Investigation.InvestigationDocument
  record:
    id: "\u04182"
    title: "\u0417\u0410\u041F\u0418\u0421\u042C \u041F\u041E\u0421\u041B\u0415 \u0418\u041D\u0426\u0418\u0414\u0415\u041D\u0422\u0410"
    date: "1999 \u0433\u043E\u0434"
    body: "1999 \u0433\u043E\u0434.\n\u042F \u0432\u043E\u0448\u0451\u043B \u0432
      \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u043C\u0435\u0442\u0440\u043E \u0432 23:51.\n\u0427\u0435\u0440\u0435\u0437
      \u0448\u0435\u0441\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u0432\u044B\u0448\u0435\u043B
      \u043E\u0434\u0438\u043D.\n\u042D\u0442\u0443 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u044F \u043F\u0440\u043E\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u044E \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440.\n\u041E\u0442\u0435\u0446 \u043F\u0440\u0438\u0448\u0451\u043B
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0437\u0430\u043F\u0443\u0441\u043A,
      \u043D\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043E\u0442\u0441\u0435\u043A
      \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F \u043F\u0440\u0435\u0436\u0434\u0435,
      \u0447\u0435\u043C \u044F \u0443\u0441\u043F\u0435\u043B \u0447\u0442\u043E-\u043B\u0438\u0431\u043E
      \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C.\n\u042F \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438
      \u0438 \u043D\u0435 \u043D\u0430\u0448\u0451\u043B \u0442\u0435\u043B\u0430.\n\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442 \u0441\u0443\u0445\u0438\u0435 \u0446\u0438\u0444\u0440\u044B
      \u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438, \u043D\u043E
      \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435.\n\u0415\u0441\u043B\u0438
      \u043F\u0440\u043E\u0445\u043E\u0434 \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0434\u043D\u0430\u0436\u0434\u044B,
      \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430."
    style: "\u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u0439, \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u044B\u0439,
      \u043B\u0438\u0447\u043D\u044B\u0439."
    stamp: 
    point: 2
  kind: 0
  presentation: 1
  size: {x: 0.175, y: 0.235}
