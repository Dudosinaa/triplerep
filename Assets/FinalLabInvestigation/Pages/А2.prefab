--- !u!114 &2021064332210640228
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2601301068471088610}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9429685eebee89c41a765a447491df8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalLab.Investigation.InvestigationDocument
  record:
    id: "\u04102"
    title: "\u0421\u0412\u0418\u0414\u0415\u0422\u0415\u041B\u042C\u0421\u0422\u0412\u041E
      \u0423\u0427\u0410\u0421\u0422\u041D\u0418\u041A\u0410"
    date: "\u043D\u043E\u044F\u0431\u0440\u044C 1887 \u0433\u043E\u0434\u0430"
    body: "\u041A\u043E\u0433\u0434\u0430 \u0441\u0432\u0435\u0442 \u043F\u043E\u0433\u0430\u0441,
      \u044F \u0443\u0441\u043B\u044B\u0448\u0430\u043B, \u043A\u0430\u043A \u043C\u0435\u043D\u044F
      \u043F\u043E\u0437\u0432\u0430\u043B\u0430 \u043C\u0430\u0442\u044C. \u041E\u043D\u0430
      \u0443\u043C\u0435\u0440\u043B\u0430 \u0441\u0435\u043C\u044C \u043B\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434.\n\u0413\u043E\u043B\u043E\u0441 \u043F\u043E\u043C\u043D\u0438\u043B
      \u0441\u0442\u0430\u0440\u0443\u044E \u0441\u0435\u043C\u0435\u0439\u043D\u0443\u044E
      \u0448\u0443\u0442\u043A\u0443, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u044F \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B.\n\u042F
      \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u0435\u043C\u0443, \u0438 \u043E\u043D
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C\u0441\u044F
      \u043A \u043A\u0440\u0443\u0433\u0443.\n\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u0438, \u0447\u0442\u043E
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0441\u043E\u0432\u0441\u0435\u043C
      \u0434\u0440\u0443\u0433\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u0430.\n\u041F\u043E\u0441\u043B\u0435
      \u0441\u0435\u0430\u043D\u0441\u0430 \u0434\u0432\u043E\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
      \u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0437\u0430\u043F\u0438\u0441\u0438. \u0422\u0440\u0435\u0442\u0438\u0439
      \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A \u0438\u0441\u0447\u0435\u0437
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.\n\u042F \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0441\u044C \u0432 \u044D\u0442\u0443
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    style: "\u043B\u0438\u0447\u043D\u043E\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0435
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435."
    stamp: 
    point: 0
  kind: 0
  presentation: 0
