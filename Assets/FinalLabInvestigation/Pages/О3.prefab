  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1992 \u0433\u043E\u0434.\n\u041C\u044B \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u043C
    \u0432 \u0410\u043C\u0435\u0440\u0438\u043A\u0443, \u0438 \u044F \u043D\u0430\u0434\u0435\u044F\u043B\u0441\u044F
    \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u044D\u0442\u0443 \u0440\u0430\u0431\u043E\u0442\u0443
    \u043F\u043E\u0437\u0430\u0434\u0438.\n\u0418\u0432\u0430\u043D \u043E\u043F\u044F\u0442\u044C
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u043E\u043C
    \u043C\u043E\u0434\u0443\u043B\u0435 \u041A-17: \u0431\u0443\u0434\u0442\u043E
    \u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u043C\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u043C
    \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439.\n\u042F
    \u0437\u0430\u043F\u0440\u0435\u0442\u0438\u043B \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443
    \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435.\n\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u043A\u0430\u0442\u0443\u0448\u043A\u0438 \u0435\u0449\u0451 \u043C\u043E\u0436\u043D\u043E
    \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C, \u043D\u043E \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A
    \u0445\u0440\u0430\u043D\u0438\u0442 \u0441\u043B\u0435\u0434\u044B \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E
    \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430.\n\u0412\u0430\u043D\u044F,
    \u0435\u0441\u043B\u0438 \u0442\u044B \u0447\u0438\u0442\u0430\u0435\u0448\u044C
    \u044D\u0442\u043E, \u043F\u0440\u043E\u0448\u0443: \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439
    \u043D\u0430\u0448 \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C \u0432 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435
    \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043F\u043E\u0434\u0432\u0430\u043B\u0430.\n\u0418\u043D\u043E\u0433\u0434\u0430
    \u043B\u0443\u0447\u0448\u0435 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
    \u043E\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F."
  m_isRightToLeft: 0
