    body: "\u0412 1887 \u0433\u043E\u0434\u0443 \u043D\u0430\u0448\u0435 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E
      \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043B\u043E \u043A \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435
      \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044F \u043E \u0427\u0451\u0440\u043D\u043E\u043C
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0435 \u2014 \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0439
      \u0441\u0438\u043B\u0435, \u044F\u043A\u043E\u0431\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
      \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0433\u043E
      \u043C\u0438\u0440\u0430.\n\u0427\u043B\u0435\u043D\u044B \u043A\u0440\u0443\u0436\u043A\u0430
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438 \u0440\u0438\u0441\u0443\u043D\u043E\u043A
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0440\u0430\u0437\u043E\u043C\u043A\u043D\u0443\u0442\u044B\u0445
      \u043A\u043E\u043B\u0435\u0446, \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0438 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0435\u0441\u044F
      \u0441\u0438\u0433\u043D\u0430\u043B\u044B.\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F
      \u043E\u043F\u044B\u0442\u043E\u0432 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u043E\u0442\u0432\u0435\u0442\u044B
      \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u043B\u0438
      \u0432\u0441\u043B\u0443\u0445.\n\u041F\u0440\u0438\u0431\u043E\u0440\u044B
      \u043D\u0438\u0447\u0435\u0433\u043E \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u043D\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0438.\n\u041C\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u043C \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435,
      \u0445\u043E\u0442\u044F \u0447\u0430\u0441\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u0433
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0435
      \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u0432\u043D\u0443\u0448\u0435\u043D\u0438\u0435\u043C."
    style: "\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043E\u0442\u0447\u0451\u0442."
    stamp: 
    point: 0
