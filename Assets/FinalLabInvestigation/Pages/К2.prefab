--- !u!114 &5877565421009929034
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8263656058148582307}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0413\u0440\u0443\u0437: \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C \u041A-17, \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \u0441 \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u043C\u0438
    \u0443\u0433\u043B\u0430\u043C\u0438.\n\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C:
    \u0418. \u041A\u0430\u0440\u0430\u043C\u0430\u0437\u043E\u0432.\n\u0413\u043E\u0434
    \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F: 1992.\n\u041C\u0430\u0440\u0448\u0440\u0443\u0442:
    \u0420\u043E\u0441\u0441\u0438\u044F \u2014 \u0421\u0428\u0410, \u041D\u044C\u044E-\u0419\u043E\u0440\u043A.\n\u0412
    \u0434\u0435\u043A\u043B\u0430\u0440\u0430\u0446\u0438\u0438 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u043A\u0430\u043A
    \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435,
    \u043D\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0435
    \u0434\u043B\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0433\u043E
    \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F.\n\u041D\u0430 \u044F\u0449\u0438\u043A\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0441\u0442\u0430\u0440\u044B\u0435
    \u043F\u043B\u043E\u043C\u0431\u044B \u0438 \u0441\u043B\u0435\u0434\u044B \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u0432\u0441\u043A\u0440\u044B\u0442\u0438\u044F.\n\u0421\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0438\u0442\u044C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043E\u0442 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F.\n\u041F\u043E\u0434\u043F\u0438\u0441\u044C
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442
    \u0441 \u0438\u043C\u0435\u043D\u0435\u043C, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u043C
    \u0432 \u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0445
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445."
