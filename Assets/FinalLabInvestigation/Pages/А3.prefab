--- !u!114 &5543441118581302774
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2367342776868647264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9429685eebee89c41a765a447491df8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalLab.Investigation.InvestigationDocument
  record:
    id: "\u04103"
    title: "\u0413\u0418\u041F\u041E\u0422\u0415\u0417\u042B \u041E \u041F\u0420\u0418\u0420\u041E\u0414\u0415
      \u041E\u0411\u042A\u0415\u041A\u0422\u0410"
    date: "1887 \u0433\u043E\u0434"
    body: "\u041F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043C, \u0447\u0442\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442.\n\u0422\u043E\u0433\u0434\u0430
      \u0435\u0433\u043E \u043E\u0442\u0432\u0435\u0442\u044B \u043C\u043E\u0433\u0443\u0442
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043E \u0434\u043E\u0441\u0442\u0443\u043F\u0435 \u043A \u043F\u0430\u043C\u044F\u0442\u0438,
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439 \u043E\u0431\u044B\u0447\u043D\u044B\u043C
      \u043E\u0440\u0433\u0430\u043D\u0430\u043C \u0447\u0443\u0432\u0441\u0442\u0432.\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F
      \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u0438
      \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0435 \u0437\u043D\u0430\u043D\u0438\u0439
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.\n\u041F\u043E\u043A\u0430 \u044D\u0442\u043E
      \u043B\u0438\u0448\u044C \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u044B.\n\u041C\u044B
      \u043D\u0435 \u0437\u043D\u0430\u0435\u043C, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u043B\u0438 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u0438\u0437\u0432\u043D\u0435 \u0438\u043B\u0438 \u0438\u0437\u0432\u043B\u0435\u043A\u0430\u0435\u0442
      \u0438\u0445 \u0438\u0437 \u043D\u0430\u0441 \u0441\u0430\u043C\u0438\u0445.\n\u041B\u044E\u0431\u043E\u0435
      \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u0430
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u043D\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043E\u043D\u043E \u0437\u0432\u0443\u0447\u0438\u0442
      \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E."
    style: "\u043D\u0430\u0443\u0447\u043D\u043E-\u044D\u043D\u0446\u0438\u043A\u043B\u043E\u043F\u0435\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0439."
    stamp: 
    point: 0
  kind: 0
  presentation: 0
  size: {x: 0.249, y: 0.331}
  hitArea: {fileID: 6960677246755711697}
  outline: {fileID: 1030493315909738671}
