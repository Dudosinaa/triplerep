  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u043F\u043E\u0434\u0432\u0430\u043B\u0435 \u043D\u0430\u0448\u0435\u0433\u043E
    \u0434\u043E\u043C\u0430 \u0418\u0432\u0430\u043D \u0441\u043D\u043E\u0432\u0430
    \u043F\u043E\u043C\u043E\u0433\u0430\u043B \u043C\u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C
    \u043A\u0430\u0442\u0443\u0448\u043A\u0438 \u0438 \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0446\u0435\u043F\u0438.\n\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
    \u043A\u0440\u043E\u043C\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0435\u0433\u043E\u0441\u044F
    \u0448\u0443\u043C\u0430, \u043C\u044B \u043F\u043E\u043A\u0430 \u043D\u0435
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438.\n\u041E\u043D \u0443\u0432\u0435\u0440\u0435\u043D,
    \u0447\u0442\u043E \u0432 \u0441\u0442\u0430\u0440\u044B\u0445 \u0430\u0440\u0445\u0438\u0432\u043D\u044B\u0445
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F\u0445 \u0441\u043A\u0440\u044B\u0442\u0430
    \u0440\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C.\n\u042F
    \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
    \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F, \u043D\u043E \u0437\u0430\u043F\u0440\u0435\u0442\u0438\u043B
    \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u043B
    \u0431\u0435\u0437 \u043C\u0435\u043D\u044F.\n\u042D\u0442\u043E \u0432\u0441\u0435\u0433\u043E
    \u043B\u0438\u0448\u044C \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430.\n\u0415\u0441\u043B\u0438 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
    \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043E\u0442\u0432\u0435\u0442,
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D
    \u043D\u0435 \u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u043D\u0430\u0448\u0438\u0445
    \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u0445."
