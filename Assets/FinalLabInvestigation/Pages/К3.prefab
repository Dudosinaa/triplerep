  m_Script: {fileID: 11500000, guid: 9429685eebee89c41a765a447491df8d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalLab.Investigation.InvestigationDocument
  record:
    id: "\u041A3"
    title: "\u0421\u0425\u0415\u041C\u0410 \u041F\u041E\u0414\u041A\u041B\u042E\u0427\u0415\u041D\u0418\u042F"
    date: "2001 \u0433\u043E\u0434"
    body: "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043A\u043E\u043D\u0442\u0443\u0440
      \u0437\u0430\u043F\u0438\u0442\u0430\u043D \u043E\u0442 \u0442\u044F\u0433\u043E\u0432\u043E\u0439
      \u0441\u0435\u0442\u0438 \u043C\u0435\u0442\u0440\u043E; \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u044B\u0439
      \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
