    \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0443.\n\u0414\u043B\u044F
    \u0440\u0435\u0436\u0438\u043C\u0430 \u0411 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C
    \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u043A\u0430\u043D\u0430\u043B, \u0437\u0430\u0442\u0435\u043C
