    \u0446\u0438\u043A\u043B.\n\u0417\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043E\u0442\u0441\u0435\u043A
    02 \u0438\u043C\u0435\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0443\u044E
    \u043B\u0438\u043D\u0438\u044E \u043F\u0438\u0442\u0430\u043D\u0438\u044F: \u043F\u0440\u0435\u0436\u0434\u0435
    \u0447\u0435\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0435\u0433\u043E,
    \u043D\u0443\u0436\u043D\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0440\u0435\u0437\u0435\u0440\u0432, \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0441\u0432\u044F\u0437\u044C \u0441 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C
