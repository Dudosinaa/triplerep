    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E.\n\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u0430 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u043F\u043E\u043B\u043D\u043E\u0439
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430.\n\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
